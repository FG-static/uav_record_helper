# D400 系列（含 D435i）用户态访问。装到 /etc/udev/rules.d/ 后：
#   sudo udevadm control --reload-rules && sudo udevadm trigger
# 然后拔插一次相机。逐条对应 librealsense 上游 config/99-realsense-libusb.rules。
#
# Linux 上 IMU 不是走 hidraw：内核 hid_sensor 驱动会占下 D435i 的 HID 接口，
# SDK 于是改用 IIO —— 它要「写」scan_elements/in_*_en 使能通道，并打开 /dev/iio:deviceN。
# 这两处默认 root:root 0644 / 0600，普通用户直接 Permission denied，缺下面两组规则就录不出 IMU。
SUBSYSTEM=="usb", ATTRS{idVendor}=="8086", ATTRS{idProduct}=="0b3a", MODE="0666"
SUBSYSTEM=="usb", ATTRS{idVendor}=="8086", ATTRS{idProduct}=="0b07", MODE="0666"
KERNEL=="hidraw*", ATTRS{idVendor}=="8086", ATTRS{idProduct}=="0b3a", MODE="0666"
KERNEL=="hidraw*", ATTRS{idVendor}=="8086", ATTRS{idProduct}=="0b07", MODE="0666"
KERNEL=="iio*", ATTRS{idVendor}=="8086", ATTRS{idProduct}=="0b3a", MODE:="0777", GROUP:="plugdev", RUN+="/bin/sh -c 'chmod -R 0777 /sys/%p'"
DRIVER=="hid_sensor*", ATTRS{idVendor}=="8086", ATTRS{idProduct}=="0b3a", RUN+="/bin/sh -c 'chmod -R 0777 /sys/%p && chmod 0777 /dev/%k'"
